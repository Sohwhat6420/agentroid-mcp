{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentroid.local/schemas/profile.json","title":"Device profile (profiles/<serial>.json)","type":"object",
"required":["serial","maker","model","sdk","skin","skin_version","touchscreen_node","settings_keys","refresh_modes","virtual_display","ime_switchable","fgs_types","appfunctions","wifi_adb","tier"],"additionalProperties":false,
"properties":{"serial":{"type":"string","minLength":1},"maker":{"type":"string"},"model":{"type":"string"},
"overlay_box":{"type":"object","required":["left","top","right","bottom","rotation"],"additionalProperties":false,
 "properties":{"left":{"type":"integer","minimum":0},"top":{"type":"integer","minimum":0},"right":{"type":"integer","minimum":0},"bottom":{"type":"integer","minimum":0},"rotation":{"enum":[0,90,180,270]}}},"sdk":{"type":"integer","minimum":29},"skin":{"type":"string"},"skin_version":{"type":"string"},
"touchscreen_node":{"type":["string","null"],"pattern":"^/dev/input/event\\d+$"},
"settings_keys":{"type":"array","items":{"type":"string"},"uniqueItems":true},
"refresh_modes":{"type":"array","items":{"type":"integer","minimum":1}},
"virtual_display":{"type":"boolean"},"ime_switchable":{"type":"boolean"},
"fgs_types":{"type":"array","items":{"type":"string"}},
"appfunctions":{"type":"boolean"},"wifi_adb":{"type":"boolean"},
"tier":{"enum":["T0","T1","T2","T3"]},
"oem_notes":{"type":"array","items":{"type":"string"}},
"probed":{"type":"boolean"}},
"if":{"properties":{"probed":{"const":false}},"required":["probed"]},"then":{"properties":{"tier":{"const":"T3"}}}}
