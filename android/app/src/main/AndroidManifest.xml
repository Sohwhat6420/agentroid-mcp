<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime permission on API 33+. Without it the foreground notification is hidden, and the helper then refuses to act. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: no `adb backup` and no cloud backup of app data. Cleartext is needed for ws:// on the tailnet
         (WireGuard encrypts it); HubSpec refuses any host that is not a tailnet address, *.ts.net or loopback. -->
    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_info_details"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- EXPORTED: the launcher starts this activity (MAIN/LAUNCHER). It shows status only and takes no input
             from other apps: it reads no extras and acts on nothing. -->
        <activity
            android:name="dev.agentroid.helper.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

