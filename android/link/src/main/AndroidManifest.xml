<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The link dials out over the network (ADR 0001). No listening socket anywhere in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Normal-level permission that qualifies a connectedDevice foreground service on API 34+ (as in the S4 spike). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- NOT exported: started only by this app (boot receiver, config receiver, accessibility service, notification action).
             directBootAware (2.12, E2 fix-up U12): on a phone with a lock the link can run before the first unlock; its
             config is in device-protected storage. dumpsys can still read its dump() (public key only). -->
        <service
            android:name="dev.agentroid.helper.link.LinkService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- NOT exported: BOOT_COMPLETED and LOCKED_BOOT_COMPLETED are protected system broadcasts, delivered to
             non-exported receivers. directBootAware so LOCKED_BOOT_COMPLETED reaches it before the first unlock. -->
        <receiver
            android:name="dev.agentroid.helper.link.BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- EXPORTED: the laptop sets the hub address and starts or stops the link with `adb shell am broadcast`,
             and the adb shell is another uid, so the receiver has to be exported. Only a caller holding
             android.permission.DUMP can send to it; the shell holds DUMP, ordinary apps cannot get it.
             It carries no secret: a hub address and a display name, both validated by HubSpec, and (2.12 PAIR) the
             hub's PUBLIC key and the serial; a private key is refused and the address must be in 100.64.0.0/10. -->
        <receiver
            android:name="dev.agentroid.helper.link.ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.agentroid.helper.PAIR" />
                <action android:name="dev.agentroid.helper.CONFIGURE" />
                <action android:name="dev.agentroid.helper.STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

