   "screen": {"p": "com.transferwise.android", "n": [
    {"c": "android.widget.FrameLayout", "b": [0, 0, 1220, 2712], "n": [
     {"c": "android.widget.ImageButton", "d": "Navigate up", "k": true, "b": [24, 120, 168, 264]},
