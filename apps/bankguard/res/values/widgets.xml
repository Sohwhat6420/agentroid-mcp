<!-- The companion widgets' palette and sizes. Sampled from the Nothing-style widgets on the owner's phones
     (Everything Widgets on the POCO, 14 Nov 2026): surface #1B1B1D, accent red #CD3733. -->
<resources>
    <color name="w_surface">#FF1B1B1D</color>
    <color name="w_slot">#FF2A2A2E</color>
    <color name="w_red">#FFCD3733</color>
    <color name="w_ink">#FFF4F4F5</color>
    <color name="w_ink_dim">#FF9A9AA0</color>

    <string name="clock_row_label">Dot clock: time, date, day</string>
    <string name="clock_row_desc">Time in a pill, the date in a red circle and the day beside it. Ticks inside the home screen: no alarms, no wakeups.</string>
    <string name="clock_large_label">Dot clock: large</string>
    <string name="clock_large_desc">A large dot-matrix time with the day, date and month. No alarms, no wakeups.</string>
    <string name="dock_label">App dock</string>
    <string name="dock_desc">A horizontal pill of up to six apps you choose. Redrawn only when you change it.</string>
