<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 like the original, resizable sideways only (as the original). No timer: redrawn when the day changes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_year"
    android:previewLayout="@layout/widget_year"
    android:description="@string/year_desc"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
