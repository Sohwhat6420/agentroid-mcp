<?xml version="1.0" encoding="utf-8"?>
<!-- Year (4x2): YEAR (red) and 41D over REMAINING in the top third; a dot a day in the lower two thirds, as the
     original (YearsDaysCountR) splits its card. Positions measured with both drawn side by side, 385 x 212 dp, in a
     test host on the POCO (20 Nov 2026). The dots are one bitmap drawn by InfoWidgets.Year. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_card_nt">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/w_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12.6dp"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/w_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12.6dp" />

        <TextView
            android:id="@+id/w_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="18.3dp"
            android:layout_marginTop="35dp"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:text="@string/year_remaining"
            android:textColor="@color/w_nt_grey_text"
            android:textSize="12sp"
            android:importantForAccessibility="no" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/w_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
</LinearLayout>
