<?xml version="1.0" encoding="utf-8"?>
<!-- Battery (2x2): 30% / WEAK, BUT STILL MOVING / the battery character standing on the card's bottom edge, as the
     original (BatteryWidgetEmojiR). Sizes and margins measured with both drawn side by side at the S24's 2x2 cell
     (188 x 212 dp) in a test host on the POCO, 20 Nov 2026. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card_nt">

    <ImageView
        android:id="@+id/w_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/w_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45.3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="13.1sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/w_nt_red"
        android:textSize="13.1sp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/w_face"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="no" />
</RelativeLayout>
