<?xml version="1.0" encoding="utf-8"?>
<!-- Earbuds (2x2): the battery (or why there is none) in small grey type, a pair of earbuds, and their name (or
     CONNECT) in dots, as the original (EarBudsBattery2R) at the S24's 2x2 cell (188 x 212 dp). The earbuds are this
     app's own drawing (w_buds), not the original's picture. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card_nt">

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/w_nt_grey_text"
        android:textSize="12.2sp"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="146dp"
        android:layout_height="98dp"
        android:layout_centerInParent="true"
        android:src="@drawable/w_buds"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="176.5dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerInside" />
</RelativeLayout>
