<?xml version="1.0" encoding="utf-8"?>
<!-- App dock: a pill of up to six app buttons. Each slot is one ImageView with a launch PendingIntent; the icons are
     drawn once when the owner changes the list (DockWidget), never on a timer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_pill">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView android:id="@+id/dock_s0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/dock_s1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/dock_s2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/dock_s3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/dock_s4" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/dock_s5" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:scaleType="fitCenter" android:visibility="gone" />

        <TextView
            android:id="@+id/dock_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE APPS"
            android:fontFamily="@font/doto_clock"
            android:textColor="@color/w_ink"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
