{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IpcApi",
  "description": "Root of the generated schema: lists every request and response type so one file defines the lot.",
  "type": "object",
  "required": [
    "device_call",
    "devices_list",
    "hello",
    "job_dry_run",
    "job_pause",
    "job_receipt",
    "job_resume",
    "job_run_script",
    "job_start",
    "job_status",
    "job_stop",
    "lease_acquire",
    "lease_release",
    "lease_status",
    "link_health",
    "link_pair_status",
    "link_segment",
    "link_segment_report",
    "rpc_request",
    "rpc_response"
  ],
  "properties": {
    "device_call": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/DeviceCallParams"
        },
        {
          "$ref": "#/definitions/DeviceCallResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "devices_list": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/DevicesListParams"
        },
        {
          "$ref": "#/definitions/DevicesListResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "hello": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/HelloParams"
        },
        {
          "$ref": "#/definitions/HelloResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_dry_run": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobDryRunParams"
        },
        {
          "$ref": "#/definitions/JobDryRunResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_pause": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobRef"
        },
        {
          "$ref": "#/definitions/JobStatusResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_receipt": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobRef"
        },
        {
          "$ref": "#/definitions/JobReceiptResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_resume": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobResumeParams"
        },
        {
          "$ref": "#/definitions/JobStatusResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_run_script": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/RunScriptParams"
        },
        {
          "$ref": "#/definitions/RunScriptResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_start": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobStartParams"
        },
        {
          "$ref": "#/definitions/JobStartResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_status": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobRef"
        },
        {
          "$ref": "#/definitions/JobStatusResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "job_stop": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/JobRef"
        },
        {
          "$ref": "#/definitions/JobStopResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "lease_acquire": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LeaseAcquireParams"
        },
        {
          "$ref": "#/definitions/Lease"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "lease_release": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LeaseReleaseParams"
        },
        {
          "$ref": "#/definitions/LeaseReleaseResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "lease_status": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LeaseStatusParams"
        },
        {
          "$ref": "#/definitions/LeaseStatusResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "link_health": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LinkHealthParams"
        },
        {
          "$ref": "#/definitions/LinkHealthResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "link_pair_status": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LinkPairStatusParams"
        },
        {
          "$ref": "#/definitions/LinkPairStatusResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "link_segment": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LinkSegmentParams"
        },
        {
          "$ref": "#/definitions/LinkSegmentResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "link_segment_report": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/LinkSegmentReportParams"
        },
        {
          "$ref": "#/definitions/LinkSegmentReportResult"
        }
      ],
      "maxItems": 2,
      "minItems": 2
    },
    "rpc_request": {
      "$ref": "#/definitions/RpcRequest"
    },
    "rpc_response": {
      "$ref": "#/definitions/RpcResponse"
    }
  },
  "definitions": {
    "ChangeOwner": {
      "description": "Who holds a settings lease.",
      "type": "object",
      "required": [
        "job_id",
        "pid",
        "session"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "session": {
          "type": "string"
        }
      }
    },
    "ChangeRow": {
      "description": "One setting changed under a care lease: `key`, `before`, `applied`, `owner` (plus where and how long).",
      "type": "object",
      "required": [
        "applied",
        "before",
        "key",
        "ns",
        "owner",
        "scope",
        "ts"
      ],
      "properties": {
        "applied": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "expires": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "ns": {
          "description": "`system`, `secure`, `global` or `vendor`.",
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/ChangeOwner"
        },
        "scope": {
          "description": "`session`, `job`, `until` (`permanent` is R2 and refused in Phase 2).",
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      }
    },
    "DeviceCallParams": {
      "type": "object",
      "required": [
        "call",
        "device"
      ],
      "properties": {
        "call": {
          "$ref": "#/definitions/ToolCall"
        },
        "device": {
          "type": "string"
        }
      }
    },
    "DeviceCallResult": {
      "type": "object",
      "required": [
        "text",
        "tool"
      ],
      "properties": {
        "attempts": {
          "description": "Attempts made (1 when nothing was retried).",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "health": {
          "description": "The health member (2.4): `alias`, `model`, `mode`, `battery`, `powered`, `temp_c`, `screen`, `lock`, `foreground {package, title}` and `age_s`, as `apps/mcp/src/header.ts` reads it. Only what the call path itself saw: a field nobody read is absent, never guessed. Never absent from the reply.",
          "default": null
        },
        "image_bytes": {
          "description": "Size of the screenshot, when the call took one (bytes are not carried over this channel yet).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "rgb": {
          "description": "`pixel_probe`: the colour, 0 to 255 each.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "maxItems": 3,
          "minItems": 3
        },
        "source": {
          "description": "`ocr` when `text` was read from an element crop by OCR on the laptop (no image in the result).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "value": {
          "description": "`set_value`: the value read back."
        }
      }
    },
    "DeviceRow": {
      "type": "object",
      "required": [
        "device",
        "hw_serial",
        "mode",
        "model",
        "serial"
      ],
      "properties": {
        "allowed": {
          "description": "Can the phone be leased: on the allowlist (`--allow-serial`, `allow.txt`, `--allow-emulators`), or the protected phone (always `read_only`, ruled reads only). A listed phone that is not allowed is visible but every call and lease on it is refused. Older daemons do not send the field; a reader treats a missing value as allowed.",
          "default": true,
          "type": "boolean"
        },
        "changes_in_force": {
          "description": "care's settings leases in force on this phone (2.13; the `changes_in_force` items of `schemas/job-view.json`). Empty when none, or when the daemon has no care configured.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChangeRow"
          }
        },
        "device": {
          "description": "Lease key: the hardware serial, or the adb serial when none is known.",
          "type": "string"
        },
        "holder": {
          "description": "Current lease holder, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "hw_serial": {
          "type": "string"
        },
        "mode": {
          "description": "`full`, `helper` or `read_only` (the protected phone is always `read_only`).",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        }
      }
    },
    "DevicesListParams": {
      "type": "object"
    },
    "DevicesListResult": {
      "type": "object",
      "required": [
        "devices"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeviceRow"
          }
        }
      }
    },
    "DryRunOverlay": {
      "type": "object",
      "required": [
        "tree",
        "verdict"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "DryRunRow": {
      "type": "object",
      "required": [
        "field",
        "kind",
        "selector",
        "step_id",
        "verdict"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "row": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "HelloParams": {
      "type": "object",
      "properties": {
        "session": {
          "description": "A label for this session (for example the Claude Code session); it becomes the lease holder name.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "required": [
        "capabilities",
        "holder",
        "name",
        "protocol",
        "version"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holder": {
          "description": "The holder name this connection will use for leases.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "JobDryRunParams": {
      "description": "`job.dry_run`: the flow against saved trees; the phone is not touched.",
      "type": "object",
      "required": [
        "device",
        "flow",
        "trees"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "flow": true,
        "trees": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SavedTreeParam"
          }
        }
      }
    },
    "JobDryRunResult": {
      "type": "object",
      "required": [
        "flow",
        "matched",
        "overlays",
        "rows",
        "text"
      ],
      "properties": {
        "flow": {
          "type": "string"
        },
        "matched": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DryRunOverlay"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DryRunRow"
          }
        },
        "text": {
          "description": "The same report as text.",
          "type": "string"
        }
      }
    },
    "JobReceiptResult": {
      "type": "object",
      "required": [
        "detail",
        "receipt",
        "run_id"
      ],
      "properties": {
        "detail": {
          "description": "The receipt panel's fields `receipt.json` has no slot for: outcome, steps retried / not run, time split into work / cooling / waiting, settings changed and restored, pop-ups dismissed."
        },
        "receipt": {
          "description": "Exactly `schemas/receipt.json`."
        },
        "recording": {
          "description": "For a job started with `record` that ended `done`: `{flow, maestro, steps, maestro_skipped}`, the two files written and what the Maestro export left as comments."
        },
        "run_id": {
          "type": "string"
        },
        "steps": {
          "description": "One row per top-level step of the job's flow, in order: `{step_id, status, note}` where status is `done`, `failed`, `interrupted`, `running` or `not_run`.",
          "type": [
            "array",
            "null"
          ],
          "items": true
        }
      }
    },
    "JobRef": {
      "description": "`job.status`, `job.pause`, `job.stop`, `job.receipt`.",
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        }
      }
    },
    "JobResumeParams": {
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "human_confirmed": {
          "description": "A person confirmed: lets a `checkpoint` step that waits for a person pass. Default false.",
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "JobStartParams": {
      "description": "`job.start`. The job runs under the caller's lease and stops before its next acting step if that lease is lost. The caller releases the lease when it is done with the device.",
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "app": {
          "description": "With `steps`: the package the steps run in (the engine relaunches it if it leaves the screen and treats it as the one expected app).",
          "type": [
            "string",
            "null"
          ]
        },
        "auto_dismiss": {
          "description": "The per-job pop-up switch; default true.",
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "device": {
          "type": "string"
        },
        "flow": {
          "description": "An inline flow: a `schemas/flow.json` object, or the same flow as YAML text. Exactly one of `flow` and `steps` is given."
        },
        "oem": {
          "description": "The phone's OEM (`xiaomi`), for OEM-scoped pop-up rules; unknown means they never apply.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "description": "Record the run: if it ends `done`, `<run id>.flow.yaml` (a flow `job.start` replays) and `<run id>.maestro.yaml` (a Maestro export) are written beside the run directory. Secret variables' values are never saved. Default false.",
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "sdk": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "steps": {
          "description": "`run_steps`: an ordered list of flow steps (`schemas/flow.json` `$defs/step`; a step with no `id` is numbered `s1`, `s2`, ...), run in order, stopping at the first failure. Needs `app`.",
          "type": [
            "array",
            "null"
          ],
          "items": true
        },
        "vars": {
          "description": "Merged into the flow's `vars` (same names win here).",
          "default": null,
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "JobStartResult": {
      "type": "object",
      "required": [
        "journal",
        "progress",
        "run_id",
        "status"
      ],
      "properties": {
        "journal": {
          "description": "`journal.ndjson` of this run.",
          "type": "string"
        },
        "progress": {
          "description": "`progress.ndjson` of this run (2.11a tails it).",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "JobStatusResult": {
      "type": "object",
      "required": [
        "device",
        "flow",
        "journal_seq",
        "line",
        "retries",
        "run_id",
        "status",
        "steps_done",
        "steps_planned"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "flow": {
          "type": "string"
        },
        "journal_seq": {
          "description": "Records in the journal: the journal position.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "One short line: progress, step, last error, health.",
          "type": "string"
        },
        "pause_reason": {
          "description": "Why it paused (`unknown_overlay`, `unreadable_screen`, `unverified_intent`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "description": "`running`, `paused`, `stuck`, `stopped`, `done` or `error` (`schemas/job-view.json`).",
          "type": "string"
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps_done": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "steps_planned": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "JobStopResult": {
      "type": "object",
      "required": [
        "journal_seq",
        "run_id",
        "status"
      ],
      "properties": {
        "journal_seq": {
          "description": "Records in the journal when it stopped.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "Lease": {
      "description": "Mirrors `schemas/registry-lease.json`.",
      "type": "object",
      "required": [
        "device",
        "epoch",
        "holder"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "holder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LeaseAcquireParams": {
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "type": "string"
        }
      }
    },
    "LeaseReleaseParams": {
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "type": "string"
        }
      }
    },
    "LeaseReleaseResult": {
      "type": "object",
      "required": [
        "released"
      ],
      "properties": {
        "released": {
          "type": "boolean"
        }
      }
    },
    "LeaseStatusParams": {
      "type": "object",
      "properties": {
        "device": {
          "description": "Only this device; default all leases.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LeaseStatusResult": {
      "type": "object",
      "required": [
        "leases"
      ],
      "properties": {
        "leases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Lease"
          }
        }
      }
    },
    "LinkHealthParams": {
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "type": "string"
        }
      }
    },
    "LinkHealthResult": {
      "type": "object",
      "required": [
        "connected",
        "device",
        "online",
        "paired",
        "reason",
        "transport"
      ],
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "device": {
          "type": "string"
        },
        "lease_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "link_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "online": {
          "type": "boolean"
        },
        "paired": {
          "type": "boolean"
        },
        "reason": {
          "description": "One line: why this transport.",
          "type": "string"
        },
